    {
      "id": "server",
      "label": "Behind the stage"
    }
  ],
  "phases": [
    {
      "id": "p1",
      "label": "1 · Snapshot",
      "fromCol": 1,
      "toCol": 1
    },
    {
      "id": "p2",
      "label": "2 · Summary",
      "fromCol": 2,
      "toCol": 2
    },
    {
      "id": "p3",
      "label": "3 · Plan",
      "fromCol": 3,
      "toCol": 3
    },
    {
      "id": "p4",
      "label": "4 · Hand-off",
      "fromCol": 4,
      "toCol": 5,
      "variant": "emphasis"
