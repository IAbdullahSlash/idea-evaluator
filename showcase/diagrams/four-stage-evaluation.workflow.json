  "cards": [
    {
      "dot": "cyan",
      "title": "Progressive",
      "items": [
        "A weak idea can stop at the Snapshot"
      ]
    },
    {
      "dot": "emerald",
      "title": "Honest",
      "items": [
        "Six explained marks; live sources"
      ]
    },
    {
      "dot": "amber",
      "title": "Sized to you",
      "items": [
        "Weeks and costs added up in code"
      ]
    }
  ]
