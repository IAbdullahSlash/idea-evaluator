          "idea",
          "snapshot",
          "summary",
          "plan",
          "handoff",
          "exports"
        ],
        "note": "Each stage opens only when you choose to continue."
      },
      {
        "id": "server",
        "label": "Behind each stage",
        "focus": [
          "analyze",
          "research",
          "stagedata",
          "docs"
        ],
        "note": "Every call is checked against a schema; research comes from live searches."
      }
    ]
  },
  "lanes": [
    {
      "id": "you",
      "label": "You"
    },
    {
      "id": "page",
      "label": "Stages on /analysis"
